{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cockpit",
  "version": "0.1.0",
  "identifier": "de.buergermiteis.cockpit",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "windows": [
      {
        "title": "Cockpit",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "decorations": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png"],
    "category": "Development",
    "shortDescription": "Zentrale fuer Claude-Code-Agenten"
  }
}
