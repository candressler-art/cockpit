# systemd-Unit fuer den Cockpit-Daemon auf serverone.
#
# System-Unit mit User=claude, nicht User-Unit: fuer den Agent-Benutzer ist
# Linger nicht gesetzt, eine --user-Unit ueberlebt das Abmelden also nicht
# zuverlaessig.
#
# Installation:
#   sudo cp deploy/cockpit.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now cockpit
#
# Die Anmeldung liegt in /home/claude/.claude/.credentials.json und wird von
# `claude auth login` dort abgelegt. /etc/cockpit/umgebung ist optional und
# nur noetig, wenn stattdessen mit einem CLAUDE_CODE_OAUTH_TOKEN gearbeitet
# werden soll.

[Unit]
Description=Cockpit -- Zentrale fuer Claude-Code-Agenten
Documentation=https://github.com/buergermiteis/cockpit
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
User=claude
Group=claude
WorkingDirectory=/opt/cockpit
# node:sqlite ist in Node 22 als experimentell markiert und warnt bei jedem
# Start. Gezielt nur diese Warnung unterdruecken, nicht alle -- sonst gehen
# echte Hinweise im Journal mit unter.
ExecStart=/usr/bin/node --disable-warning=ExperimentalWarning /opt/cockpit/dist/daemon.js
# Fuehrendes Minus: fehlt die Datei, startet die Unit trotzdem. Der Daemon
# selbst braucht keine Anmeldung -- nur die Agenten, die er startet. So kann
# der Dienst schon laufen und melden, dass die Anmeldung fehlt, statt gar
# nicht erst hochzukommen.
EnvironmentFile=-/etc/cockpit/umgebung
Environment=NODE_ENV=production
# Explizit, nicht auf systemd verlassen: die Claude-CLI sucht ihre Anmeldung
# unter $HOME/.claude/.credentials.json. Ohne gesetztes HOME findet sie sie
# nicht und meldet sich als nicht angemeldet, obwohl die Datei existiert.
Environment=HOME=/home/claude
Environment=COCKPIT_HOST=127.0.0.1
Environment=COCKPIT_PORT=8765
Environment=COCKPIT_DB=/var/lib/cockpit/cockpit.db

# Neustart, aber nicht endlos im Kreis: schlaegt der Start fuenfmal in zwei
# Minuten fehl, liegt ein echter Fehler vor, den ein weiterer Versuch nicht
# behebt -- dann soll die Unit stehenbleiben und sichtbar sein.
Restart=on-failure
RestartSec=5
StartLimitBurst=5
StartLimitIntervalSec=120

# Der Daemon startet Claude-Code-Prozesse, die Dateien schreiben duerfen
# muessen. Deshalb kein ProtectSystem=strict; die Einschraenkungen hier sind
# die, die damit vertraeglich sind.
NoNewPrivileges=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
StateDirectory=cockpit

StandardOutput=journal
StandardError=journal
SyslogIdentifier=cockpit

[Install]
WantedBy=multi-user.target
